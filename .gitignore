# Dependencies — regenerated by `python eido.py bootstrap` (deno + deno.lock)
node_modules/

# Agent scratch space + run outputs
work/
runs/

# Per-run brief/context/capabilities handshake files (written by eido.py)
_brief.txt
_context.txt
_capabilities.json

# Python bytecode
__pycache__/
*.pyc

# Render byproducts
*.log
qc_frames/

# eido.py render --probe artifacts
*_probe.json
*_probe.mp4

# Rendered example outputs + review frames (regenerate via eido.py render)
eidoverse/examples/*.mp4
eidoverse/examples/*.png

# The shared texture/model library: third-party CC0 sets are fetched on first use (fetch_texture.py / fetch_model.py --cache), never committed
eidoverse/assets/cache/

# Blender edition: each family's test renders, builds and digests (regenerate with its tests), and Blender's backups
blender/tests/*/out/
*.blend1

# The terrain build's triage renders, sheets, research images and fetched real elevation data (regenerate them with
# the scripts beside them: triage/render.py, reference/fetch_references.py + render_references.py)
blender/tests/terrain_new/**/*.png
blender/tests/terrain_new/**/*.jpg
blender/tests/terrain_new/**/*.npz
blender/tests/terrain_new/**/*.npy
blender/tests/terrain_new/**/*.exr
